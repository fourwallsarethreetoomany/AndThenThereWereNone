class RailgunWeapon:
    def __init__(self, owner, offset=pygame.Vector2(0, 0), is_player=True):
        self.owner = owner
        self.offset = pygame.Vector2(offset)
        self.range = 150000
        self.cooldown = 0
        self.fire_rate = 85
        self.is_player = is_player
        self.last_target_pos = None

        self.slug_speed = 400.0

    def get_world_pos(self):
        rad = math.radians(-self.owner.angle)

        rx = (
            self.offset.x * math.cos(rad)
            - self.offset.y * math.sin(rad)
        )
        ry = (
            self.offset.x * math.sin(rad)
            + self.offset.y * math.cos(rad)
        )

        return self.owner.pos + pygame.Vector2(rx, ry)

    def calculate_intercept(self, mount_pos, target): #predict future position, returns positiona dn time none if non are found
        target_pos = pygame.Vector2(target.pos)

        target_vel = pygame.Vector2(
            getattr(target, "velocity", pygame.Vector2(0, 0))
        )

        # Target acceleration in its current facing direction.
        target_rad = math.radians(
            -getattr(target, "angle", 0)
        )

        target_forward = pygame.Vector2(
            math.cos(target_rad),
            math.sin(target_rad)
        )

        accel_mag = getattr(
            target, "acceleration_magnitude", 0.0
        )

        target_accel = target_forward * accel_mag

        #   jerk using the target's current heading.
        target_jerk = pygame.Vector2(0, 0)

        if accel_mag > 0:
            target_jerk = target_forward * getattr(
                target, "jerk", 0.0
            )

        #   position and velocity at launch.
        #   the slug inherits the owner's current velocity.
        relative_pos = target_pos - mount_pos

        owner_vel = pygame.Vector2(
            getattr(self.owner, "velocity", pygame.Vector2(0, 0))
        )

        relative_vel = target_vel - owner_vel

        speed = self.slug_speed

        if speed <= 0:
            return target_pos, None

        # A projectile traveling at this speed cannot cover more than this distance within the weapon's range.
        max_time = self.range / speed

        def position_error(t): #helper
            # target position relative to the moving shooter.
            relative_future = ( # I honestly think we should make ap physics 1 include calculus
                relative_pos
                + relative_vel * t
                + 0.5 * target_accel * (t ** 2)
                + (1.0 / 6.0) * target_jerk * (t ** 3) #This will have zero negative consequences towards the performance of the game. 
            ) # ive optimized it as much as i can okay? its already in the taylor series form can you stop running my CPU usage up by 8%?

            # zero means projectile travel distance matches the distance to the predicted target position.
            return relative_future.length() - speed * t # returns difference, positive meand the railgun lags behind, negative means overshoot

        # find the earliest intercept by searching for a sign change then reinfe it with binary search.
        steps = 900 # This also will have no negative consequences towards the performance of the game. oh my god every time i boot up vs code my laptop fan spins up.
        previous_t = 0.0 # this entire loop is basically turning the max flight time into 900 chunks 
        # and we find the exact flight time that will cause a lagging railgun to hit the target. 
        # after we have found a lower and upper bound we feed it into a binary search to find an even more accurate number
        #then after we found the travel time we feed that time into  another kinematics equation to find where
        # the enemy will be then we ensure that the railgun isn;t pointing in the exact opposite direction
        # as the target, and then can fire at the enemy.
        previous_error = position_error(previous_t)  
        for i in range(1, steps + 1): 
            current_t = max_time * i / steps
            current_error = position_error(current_t)

            if previous_error > 0 and current_error <= 0:
                low = previous_t
                high = current_t

                for _ in range(30):
                    mid = (low + high) / 2

                    if position_error(mid) > 0:
                        low = mid
                    else:
                        high = mid

                intercept_time = (low + high) / 2

                # predict the target's world position.
                predicted_pos = (
                    target_pos
                    + target_vel * intercept_time
                    + 0.5 * target_accel * (intercept_time ** 2)
                    + (1.0 / 6.0)
                    * target_jerk
                    * (intercept_time ** 3) # THIS WILL HAVE NO NEGATIVE CONSEQUENCESS TOWARDS THE PERFORMANCE OF THE GAME
                )

                # reject predictions that are behaind the weapon.
                to_pred = predicted_pos - mount_pos
                to_target = target_pos - mount_pos

                if to_pred.dot(to_target) < 0:
                    return target_pos, None

                return predicted_pos, intercept_time

            previous_t = current_t
            previous_error = current_error

        # No valid intercept found.
        return target_pos, None

    def update(self, potential_targets, slugs_group):
        if self.cooldown > 0:
            self.cooldown -= 1

        mount_pos = self.get_world_pos()

        # Railguns deson;t target enemy ships bug fixed
        valid_targets = [
            t for t in potential_targets
            if isinstance(t, Ship)
            and t != self.owner
            and getattr(t, "is_player", None) != self.is_player
        ]

        if not valid_targets:
            self.last_target_pos = None
            return

        # select the closest enemy ship to the weapon mount.
        closest_target = min(
            valid_targets,
            key=lambda t: mount_pos.distance_to(
                t.pos if hasattr(t, "pos")
                else pygame.Vector2(t.rect.center)
            )
        ) # I will say this was less cinematic than what i had in midn

        t_pos = (
            closest_target.pos
            if hasattr(closest_target, "pos")
            else pygame.Vector2(closest_target.rect.center)
        )

        dist = mount_pos.distance_to(t_pos)

        # calculate the predicted intercept on every frame.
        predicted_pos, intercept_time = self.calculate_intercept(
            mount_pos,
            closest_target
        )

        self.last_target_pos = predicted_pos

        # Leonidas-class ships cannot fire while accelerating. womp womp
        can_fire = True

        if (
            getattr(
                self.owner,
                "cannot_fire_while_accelerating",
                False
            )
            and getattr(
                self.owner,
                "acceleration_magnitude",
                0.0) > 0
        ):
            can_fire = False

        # Fire only when a valid intercept is available.
        if (
            intercept_time is not None
            and dist <= self.range
            and self.cooldown == 0
            and can_fire
        ):
            keys = pygame.key.get_pressed()

            if not self.is_player or keys[pygame.K_r]:
                slug = RailgunSlug(
                    mount_pos.x,
                    mount_pos.y,
                    predicted_pos,
                    self.is_player
                )

                slugs_group.add(slug)
                self.cooldown = self.fire_rate



